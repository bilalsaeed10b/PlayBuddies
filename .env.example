# Firebase web config.
#
# These values are NOT secrets — they identify the project and ship in the
# client bundle by design. Access is controlled by firestore.rules and
# database.rules.json, not by hiding these.
#
# The app has working defaults committed, so you only need this file to point a
# build at a different Firebase project. Copy to .env.local and fill in.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# For a game (place in games/<id>/.env.local):
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_DATABASE_URL=

# Local diagnostics CLI only. This is a filesystem path, never a public build
# variable and never a credential that should be committed.
# PLAYBUDDIES_SERVICE_ACCOUNT=C:\secure\playbuddies-service-account.json
# PLAYBUDDIES_FIREBASE_PROJECT=playbuddies-556cd

# Optional build override. The default enables remote diagnostics on public
# HTTPS hosts and leaves localhost/LAN collection to scripts/serve.mjs.
# NEXT_PUBLIC_REMOTE_DIAGNOSTICS=on
