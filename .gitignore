# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
dist

# Built games. games/<id>/ is the source of truth; public/g/ is generated by
# `npm run build:games` and must never be edited or committed. Committing build
# output is what let six copies of the same game drift apart.
/public/g/
/src/lib/games.generated.ts

# misc
.DS_Store
*.pem
Thumbs.db

# dev-only playtest log, written by games/_shared/devlog's Vite plugin.
# Local debugging output, never committed.
/dev-logs/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
