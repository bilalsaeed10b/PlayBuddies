{
  "rules": {
    "presence": {
      "users": {
        "$uid": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "!newData.exists() || newData.hasChildren(['online'])",
          "online": { ".validate": "newData.isBoolean()" },
          "at": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      },
      "lobbies": {
        "$roomId": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "!newData.exists() || newData.isBoolean()"
          }
        }
      }
    },
    "signaling": {
      "$roomId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "lobbies": {
      "$roomId": {
        "updates": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
