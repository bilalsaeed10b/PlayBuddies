{
  "rules": {
    "presence": {
      "users": {
        "$uid": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "!newData.exists() || newData.hasChildren(['online'])",
          "online": { ".validate": "newData.isBoolean()" },
          "at": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      },
      "lobbies": {
        "$roomId": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "!newData.exists() || newData.isBoolean()"
          }
        }
      }
    },
    "signaling": {
      "$roomId": {
        "$uid": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $uid",
          "$peerId": {
            "desc": {
              ".validate": "newData.hasChildren(['type', 'sdp'])",
              "type": { ".validate": "newData.isString() && newData.val().length <= 16" },
              "sdp": { ".validate": "newData.isString() && newData.val().length <= 20000" },
              "$other": { ".validate": false }
            },
            "candidates": {
              "$candidateId": {
                ".validate": "newData.isString() && newData.val().length <= 2000"
              }
            },
            "$other": { ".validate": false }
          }
        }
      }
    },
    "relay": {
      "$roomId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          "m": { ".validate": "newData.isString() && newData.val().length <= 8000" },
          "n": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
