{
  "rules": {
    "presence": {
      "users": {
        "$uid": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['online']) || !newData.exists()"
        },
        ".read": "auth != null"
      },
      "lobbies": {
        "$roomId": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isBoolean() || !newData.exists()"
          }
        }
      }
    },
    "signaling": {
      "$roomId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
