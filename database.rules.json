{
  "rules": {
    "presenceSessions": {
      // Each tab writes one child under its own uid; a user counts as online
      // while any child survives. The admin allowlist may read the whole set
      // at once, which is what the panel's online count needs: per-uid is the
      // only other readable node, and counting from those would mean one
      // listener per account for every account on the platform.
      "users": {
        ".read": "auth != null && auth.token.email_verified === true && (auth.token.email === 'bilalsaeed10b@gmail.com' || auth.token.email === 'bilalsaeed12b@gmail.com')",
        "$uid": {
          ".read": "auth != null",
          "$connection": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isBoolean() && newData.val() === true"
          }
        }
      },
      "lobbies": {
        "$roomId": {
          ".read": "auth != null",
          "$uid": {
            "$connection": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.isBoolean() && newData.val() === true"
            }
          }
        }
      }
    },
    "presence": {
      "users": {
        "$uid": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "!newData.exists() || newData.hasChildren(['online'])",
          "online": {
            ".validate": "newData.isBoolean()"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "lobbies": {
        "$roomId": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "!newData.exists() || newData.isBoolean()"
          }
        }
      }
    },
    "signaling": {
      "$roomId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "lobbies": {
      "$roomId": {
        "updates": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },
    // Switches the admin panel flips for the whole platform: a banner,
    // maintenance mode, games taken out of the catalog. Every signed-in page
    // reads it; only the admin allowlist writes it.
    "platform": {
      "config": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email_verified === true && (auth.token.email === 'bilalsaeed10b@gmail.com' || auth.token.email === 'bilalsaeed12b@gmail.com')"
      },
      // Suspended accounts. A player may read their own entry (that is how
      // their page learns it) and nobody else's; only an admin writes or
      // lists them.
      "bans": {
        ".read": "auth != null && auth.token.email_verified === true && (auth.token.email === 'bilalsaeed10b@gmail.com' || auth.token.email === 'bilalsaeed12b@gmail.com')",
        ".write": "auth != null && auth.token.email_verified === true && (auth.token.email === 'bilalsaeed10b@gmail.com' || auth.token.email === 'bilalsaeed12b@gmail.com')",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid"
        }
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
