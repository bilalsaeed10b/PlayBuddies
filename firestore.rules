rules_version = '2';

// PlayBuddies is a static site with no backend, so these rules are the ONLY
// thing standing between a browser and the database. Assume every client is
// hostile: the Firebase config, the collection names and the document shapes
// are all visible in the shipped bundle.
//
// Two habits matter most here:
//   * `allow read` grants BOTH get and list. Granting it broadly lets anyone
//     enumerate a whole collection, not just fetch the doc they were given.
//   * Anything a client can write, a client can write garbage into. Cap sizes
//     and pin down which keys a write may touch.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    /**
     * The admin panel's only real door.
     *
     * The allowlist is duplicated in src/lib/admin.ts and storage.rules. The
     * copy in the bundle decides what to render; this one decides what the
     * database will answer, and it is the one that matters , anybody can edit
     * the shipped JavaScript, nobody can edit this.
     *
     * Addresses rather than uids so the first admin can sign in without
     * someone first copying a uid out of the Firebase console, and
     * `email_verified` because an unverified address on a token is a claim,
     * not a fact. Google verifies its own accounts, so this costs real admins
     * nothing.
     */
    function isAdmin() {
      return signedIn()
             && request.auth.token.email_verified == true
             && request.auth.token.email in [
               'bilalsaeed10b@gmail.com',
               'bilalsaeed12b@gmail.com'
             ];
    }

    /** Keys this write actually changes. */
    function touched() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function incoming() {
      return request.resource.data;
    }

    /** Friend links are keyed by the two uids sorted, joined with "_". */
    function friendshipAccepted(a, b) {
      return (exists(/databases/$(database)/documents/connections/$(a + '_' + b))
              && get(/databases/$(database)/documents/connections/$(a + '_' + b)).data.status == 'accepted')
          || (exists(/databases/$(database)/documents/connections/$(b + '_' + a))
              && get(/databases/$(database)/documents/connections/$(b + '_' + a)).data.status == 'accepted');
    }

    // ─── Private user record ───
    // Holds email and stats. Readable ONLY by its owner.
    //
    // This used to be `allow read: if signedIn()`, which — because read implies
    // list — let any signed-in account run one query and walk off with every
    // user's email address. Anything other players need to see now lives in
    // /profiles instead.
    match /users/{userId} {
      allow get: if isSelf(userId) || isAdmin();
      // Listing every user is exactly the scrape this rule was written to stop.
      // The admin panel's player table is the one caller that legitimately
      // needs it, and it can only ever be an admin asking.
      allow list: if isAdmin();

      allow create: if isSelf(userId)
                    && incoming().email is string
                    && incoming().email.size() <= 320;

      // An admin crediting an approved report writes to the reporter's
      // document, which merges into a create if that document was never
      // written. Without this the credit fails after the status change has
      // already been saved, leaving the two halves out of step.
      allow create: if isAdmin();

      /**
       * A match result: one game played, at most one win.
       *
       * This used to be refused outright, on the grounds that stats belong to
       * trusted code. There is no trusted code: PlayBuddies is a static site
       * with no server and no Cloud Functions, so refusing the write did not
       * make the counters trustworthy, it only made them permanently zero.
       *
       * What is enforced instead is the shape of an honest match. A write may
       * add one game and no more, may add a win only alongside that game, and
       * can never take either counter backwards. Inflating a record therefore
       * costs one request per fake game rather than one request for all of
       * them, which is the most a client-only site can ask for.
       */
      function statsStep() {
        let before = resource.data.get('stats', { 'gamesPlayed': 0, 'wins': 0 });
        let after = incoming().stats;
        let playedBefore = before.get('gamesPlayed', 0);
        let winsBefore = before.get('wins', 0);
        return after.keys().hasOnly(['gamesPlayed', 'wins'])
               && after.gamesPlayed is int
               && after.wins is int
               && after.gamesPlayed == playedBefore + 1
               && after.wins >= winsBefore
               && after.wins <= winsBefore + 1
               && after.wins <= after.gamesPlayed;
      }

      /**
       * The wallet. Coins are points with no cash value, so the checks here are
       * only there to stop a junk write, not to protect an asset.
       *
       * Coins are keyed per game, the same shape as `unlocks` and for the same
       * reason: a balance earned in one game should not buy anything in
       * another. That rules out the old per-write step cap (`next <= previous +
       * 5000`) along with the scalar it was written against — checking a step
       * per game would mean iterating the map's values, which the rules
       * language cannot do without knowing every game's key in advance, and
       * hard-coding that list here would make shipping a new game a two-repo
       * change. `unlocks` already accepted that trade: it has never had a
       * per-write bound on what a list may contain, only a shape and a size
       * limit on the map itself. Coins get the same deal now.
       */
      function walletStep() {
        let coins = incoming().get('coins', {});
        let unlocks = incoming().get('unlocks', {});
        return coins is map
               && coins.size() <= 12
               && unlocks is map
               && unlocks.size() <= 12;
      }

      /**
       * One filed bug report.
       *
       * `submitted` is the reporter's own running total and may step by one.
       * `approved` is the number the tester badges are actually built on, so
       * it is pinned here: a reporter may not move it, and the only writer
       * that can is an admin approving a report. Without that pin the badge
       * would be self-serve.
       */
      function bugStatsStep() {
        let before = resource.data.get('bugStats', { 'submitted': 0, 'approved': 0 });
        let after = incoming().bugStats;
        return after.keys().hasOnly(['submitted', 'approved'])
               && after.get('submitted', 0) is int
               && after.get('submitted', 0) == before.get('submitted', 0) + 1
               && after.get('approved', 0) == before.get('approved', 0);
      }

      allow update: if isSelf(userId)
                    && !touched().hasAny(['uid', 'createdAt', 'friendCode'])
                    // Badges an admin hands out, and the count they are earned
                    // from, are never writable by the account that wears them.
                    && !touched().hasAny(['grants'])
                    && (!touched().hasAny(['stats']) || statsStep())
                    && (!touched().hasAny(['bugStats']) || bugStatsStep())
                    && (!touched().hasAny(['coins', 'unlocks']) || walletStep());

      // Grants, bug counters, coin corrections: the panel's side of the same
      // document. Deliberately unconstrained in shape , an admin editing a
      // record by hand is the trusted path, not the one being defended against.
      allow update: if isAdmin();

      allow delete: if false;
    }

    // ─── Public profile ───
    // Only ever displayName / photoURL / friendCode. Listable because friend
    // search queries it by code — so it must never gain a sensitive field.
    match /profiles/{userId} {
      allow get: if signedIn();
      // Bounded so enumeration can't be used to scrape the whole user base
      // cheaply. Friend search fetches a single exact-match document.
      allow list: if isAdmin() || (signedIn() && request.query.limit <= 20);

      /** Does this account actually hold the grant behind a badge? */
      function holdsGrant(key) {
        return get(/databases/$(database)/documents/users/$(userId))
               .data.get('grants', {}).get(key, false) == true;
      }

      /**
       * `badge` is the one shown beside this player's name wherever other
       * people see it, which is why it is checked rather than trusted.
       *
       * Stat badges pass straight through: they are derived from counters the
       * account can already nudge, so verifying them here would cost a read
       * and prove nothing. The three that mean something , both tester tiers
       * and premium , are only wearable if an admin actually granted them.
       */
      function badgeClaimOk() {
        let badge = incoming().get('badge', '');
        return badge is string
               && badge.size() <= 24
               && (badge == 'tester' ? holdsGrant('tester')
                  : badge == 'tester_plus' ? holdsGrant('testerPlus')
                  : badge == 'premium' ? holdsGrant('premium')
                  : true);
      }

      allow write: if isSelf(userId)
                   && incoming().keys().hasOnly(['uid', 'displayName', 'photoURL', 'friendCode', 'updatedAt', 'badge'])
                   && incoming().displayName is string
                   && incoming().displayName.size() <= 60
                   && incoming().photoURL is string
                   && incoming().photoURL.size() <= 500
                   && incoming().friendCode is string
                   && incoming().friendCode.size() == 8
                   && badgeClaimOk();
    }

    // Aim totals are intentionally tiny and get-only: the ship picker reads
    // only the handful of captains in the lobby, never a browsable directory.
    match /pirateStats/{userId} {
      function validAim(aim) {
        return aim is map
               && aim.keys().hasOnly(['shots', 'hits'])
               && aim.shots is int && aim.hits is int
               && aim.shots >= 0 && aim.hits >= 0 && aim.hits <= aim.shots;
      }

      function validWeek(week) {
        return week is map
               && week.keys().hasOnly(['id', 'shots', 'hits'])
               && week.id is string && week.id.size() <= 16
               && week.shots is int && week.hits is int
               && week.shots >= 0 && week.hits >= 0 && week.hits <= week.shots;
      }

      allow get: if signedIn();
      allow list: if false;
      allow create, update: if isSelf(userId)
                            && incoming().keys().hasOnly(['allTime', 'week', 'updatedAt'])
                            && validAim(incoming().allTime)
                            && validWeek(incoming().week);
      allow delete: if false;
    }

    // ─── Bug reports ───
    // Filed by any signed-in player, triaged only by an admin.
    //
    // The split matters more than it looks. A report is the raw claim, and the
    // status on it is the admin's verdict; if a reporter could edit either one
    // after the fact, approving ten reports would mean nothing and the tester
    // badge behind that count would mean less.
    match /bugReports/{reportId} {
      function validNewReport() {
        return incoming().keys().hasOnly([
                 'uid', 'reporterName', 'reporterEmail', 'reporterPhoto',
                 'title', 'description', 'gameId', 'roomId', 'severity',
                 'category', 'status', 'screenshotPath', 'screenshotURL',
                 'context', 'adminNotes', 'countedForBadge',
                 'createdAt', 'updatedAt', 'resolvedAt', 'resolvedBy'
               ])
               && incoming().uid == request.auth.uid
               && incoming().title is string
               && incoming().title.size() > 0
               && incoming().title.size() <= 120
               && incoming().description is string
               && incoming().description.size() <= 2000
               && incoming().reporterName is string && incoming().reporterName.size() <= 60
               && incoming().reporterEmail is string && incoming().reporterEmail.size() <= 320
               && incoming().reporterPhoto is string && incoming().reporterPhoto.size() <= 500
               && incoming().gameId is string && incoming().gameId.size() <= 48
               && incoming().roomId is string && incoming().roomId.size() <= 6
               && incoming().severity in ['low', 'medium', 'high', 'critical']
               && incoming().category in ['gameplay', 'graphics', 'audio', 'network',
                                          'ui', 'performance', 'crash', 'other']
               // A report always starts in the queue. Filing one pre-approved
               // would hand the reporter the badge outright.
               && incoming().status == 'new'
               && incoming().countedForBadge == false
               && incoming().adminNotes == ''
               && incoming().resolvedBy == ''
               && incoming().createdAt == request.time
               && incoming().context is map
               && incoming().context.size() <= 20;
      }

      /**
       * The one edit a reporter may make to their own report, and only while
       * it is still untouched: attaching the screenshot, which cannot be
       * written until the document exists and has an id to name the file by.
       */
      function attachingOwnScreenshot() {
        return isSelf(resource.data.uid)
               && resource.data.status == 'new'
               && touched().hasOnly(['screenshotPath', 'screenshotURL'])
               && incoming().screenshotPath is string
               && incoming().screenshotPath.size() <= 300
               && incoming().screenshotURL is string
               && incoming().screenshotURL.size() <= 1000;
      }

      allow get: if isAdmin() || (signedIn() && request.auth.uid == resource.data.uid);
      // List rules are evaluated per returned document, so a query that could
      // return somebody else's report fails as a whole rather than quietly
      // filtering. That makes this the entire enforcement for "your reports
      // only": bugs.ts asks with where('uid','==',me), and any wider query is
      // refused outright.
      allow list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);

      allow create: if signedIn() && validNewReport();
      allow update: if isAdmin() || attachingOwnScreenshot();
      allow delete: if isAdmin();
    }

    // ─── Friend connections ───
    match /connections/{connId} {
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/connections/$(connId))
                     || request.auth.uid in resource.data.participants);
      allow list: if signedIn();

      allow create: if signedIn()
                    && request.auth.uid == incoming().senderId
                    && request.auth.uid in incoming().participants
                    && incoming().participants.size() == 2
                    && incoming().status == 'pending'
                    // Doc id must be the two uids sorted, so a pair can only
                    // ever have one connection document.
                    && connId == incoming().participants[0] + '_' + incoming().participants[1]
                    && incoming().participants[0] < incoming().participants[1];

      // Only the recipient can accept, and status is the only field that may
      // change — a sender cannot self-accept their own request.
      allow update: if signedIn()
                    && request.auth.uid in resource.data.participants
                    && request.auth.uid != resource.data.senderId
                    && touched().hasOnly(['status'])
                    && incoming().status == 'accepted';

      allow delete: if signedIn() && request.auth.uid in resource.data.participants;
    }

    // ─── Lobby invites ───
    match /invites/{inviteId} {
      allow get: if signedIn() && request.auth.uid == resource.data.targetId;
      allow list: if signedIn();

      // Friends only. Without this, any account could fire unlimited invites at
      // any uid it had seen — harassment, and an unbounded write bill.
      allow create: if signedIn()
                    && request.auth.uid == incoming().fromUid
                    && incoming().targetId is string
                    && incoming().targetId != request.auth.uid
                    && incoming().roomId is string
                    && incoming().roomId.size() == 6
                    && friendshipAccepted(request.auth.uid, incoming().targetId);

      // Either party may clear it: the recipient on accept/decline, the sender
      // to withdraw. Otherwise a declined invite lingers forever.
      allow delete: if signedIn()
                    && (request.auth.uid == resource.data.targetId
                        || request.auth.uid == resource.data.fromUid);
      allow update: if false;
    }

    // ─── Lobbies ───
    match /lobbies/{lobbyId} {
      function isLobbyHost() {
        return signedIn() && resource.data.hostId == request.auth.uid;
      }

      function isMember() {
        return signedIn() && request.auth.uid in resource.data.players;
      }

      // MapDiff operates on keys of this map, so compare players separately.
      function touchesOnlyOwnPlayerSlot() {
        let uid = request.auth.uid;
        let next = incoming().players;
        let own = next.get(uid, {});
        return touched().hasOnly(['players', 'updatedAt'])
               && next is map
               && next.diff(resource.data.players).affectedKeys().hasOnly([uid])
               && (!(uid in next) || (
                 own.keys().hasOnly(['uid', 'displayName', 'photoURL', 'isReady', 'joinedAt', 'role', 'fishIndex'])
                 && own.uid == uid
                 && own.displayName is string && own.displayName.size() <= 60
                 && own.photoURL is string && own.photoURL.size() <= 500
                 && own.isReady is bool
               ));
      }

      // RTDB presence cannot be read from Firestore rules. A server-timestamped
      // heartbeat provides the authority check, rather than trusting a guest.
      function canClaimHost() {
        let previous = resource.data.hostId;
        let lastSeen = resource.data.get('hostSeenAt', resource.data.createdAt);
        return isMember()
               && lastSeen is timestamp
               && request.time > lastSeen + duration.value(30, 's')
               && touched().hasOnly(['hostId', 'hostSeenAt', 'players'])
               && incoming().hostId == request.auth.uid
               && incoming().hostSeenAt == request.time
               && !(previous in incoming().players)
               && incoming().players.diff(resource.data.players).affectedKeys().hasOnly([previous]);
      }

      // A room code is a capability: knowing it lets you read the room. But
      // `list` is refused, so codes cannot be harvested in bulk.
      //
      // With list allowed, one query returned every live room code along with
      // every player's uid, name and photo — enough to walk into any game on
      // the platform.
      allow get: if signedIn();
      // Still refused for players , see above. The admin panel's live-rooms
      // board is the one caller that needs the whole list, and it is the one
      // caller that can be trusted with every room code on the platform.
      allow list: if isAdmin();

      allow create: if signedIn()
                    && incoming().hostId == request.auth.uid
                    && incoming().hostSeenAt == request.time
                    && incoming().players.size() <= 8
                    && incoming().status in ['waiting', 'playing', 'completed'];

      allow update: if incoming().players is map && incoming().players.size() <= 8 && (
        // Only the current host may change rules, game selection or start/end.
        (isLobbyHost()
         && (!touched().hasAny(['hostSeenAt']) || incoming().hostSeenAt == request.time))
        || (signedIn() && touchesOnlyOwnPlayerSlot())
        || canClaimHost()
      );

      // An admin can also close a room outright , the case this covers is a
      // host who disconnected and never came back, which canClaimHost() only
      // resolves after 30 quiet seconds and only for a member still present
      // to claim it. A room nobody is left in has no such member.
      allow delete: if isLobbyHost() || isAdmin();

      // ─── Lobby chat ───
      // A subcollection so messages never bloat the room document.
      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn()
                      && incoming().uid == request.auth.uid
                      && incoming().text is string
                      && incoming().text.size() > 0
                      && incoming().text.size() <= 200
                      && incoming().displayName is string
                      && incoming().displayName.size() <= 60;
        allow update, delete: if false;
      }

      // ─── Per-player game state ───
      // One document per player, keyed by their own uid, written at up to 20Hz
      // during a match.
      //
      // Membership is deliberately NOT verified here: that would need a get()
      // on the parent lobby for every write, doubling the cost of the hottest
      // path in the app. The key is already pinned to the writer's uid, so the
      // worst a stranger achieves is one junk document in a room nobody reads
      // — and any account can already create its own lobbies.
      match /updates/{playerId} {
        allow read: if signedIn();
        allow write: if isSelf(playerId) && incoming().size() <= 20;
      }
    }

    // ── Remote playtest diagnostics ────────────────────────────────────────
    // Games cannot write here directly. Their authenticated lobby page checks
    // the iframe source, sanitizes each entry, and stores a small batch. Logs
    // are deliberately unreadable to web clients; the diagnostics CLI uses a
    // Firebase service account and therefore never depends on a permissive
    // production read rule.
    match /diagnostics/{roomId}/batches/{batchId} {
      function lobbyMember() {
        return signedIn()
               && exists(/databases/$(database)/documents/lobbies/$(roomId))
               && request.auth.uid in get(/databases/$(database)/documents/lobbies/$(roomId)).data.players;
      }

      allow create: if lobbyMember()
                    && incoming().keys().hasOnly([
                      'uid', 'who', 'room', 'game', 'client', 'session', 'build',
                      'receivedAt', 'expiresAt', 'entries'
                    ])
                    && incoming().uid == request.auth.uid
                    && incoming().room == roomId
                    && incoming().who is string && incoming().who.size() <= 60
                    && incoming().game is string && incoming().game.size() <= 48
                    && incoming().client is string && incoming().client.size() <= 32
                    && incoming().session is string && incoming().session.size() <= 100
                    && incoming().build is string && incoming().build.size() <= 100
                    && incoming().receivedAt == request.time
                    && incoming().expiresAt is timestamp
                    && incoming().expiresAt > request.time + duration.value(6, 'd')
                    && incoming().expiresAt < request.time + duration.value(8, 'd')
                    && incoming().entries is list
                    && incoming().entries.size() > 0
                    && incoming().entries.size() <= 40;

      allow get, list, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
