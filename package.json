{
  "name": "playbuddies",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "npm run build:games && next build",
    "build:games": "node scripts/build-games.mjs",
    "registry": "node scripts/build-games.mjs --registry-only",
    "start": "next start",
    "lint": "npm run registry && eslint",
    "typecheck": "npm run registry && tsc --noEmit",
    "serve": "node scripts/serve.mjs",
    "host": "npm run build && node scripts/serve.mjs"
  },
  "dependencies": {
    "firebase": "^12.11.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.577.0",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
